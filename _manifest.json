{
  "manifest_version": 2,
  "id": "omsociety.argo-lookup",
  "version": "1.0.0",
  "name": "argo 检索",
  "description": "把本机 argo 的检索与长任务能力交给麦麦：按问题类型选源（中文综合、时事、中文期刊题录、社科全文、外文文献、DOI 全文、书目、配图、GitHub），长任务提交即返回、稍后取结果",
  "author": {
    "name": "OMSociety",
    "url": "https://github.com/OMSociety"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/OMSociety/maibot_plugin_argo-lookup"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.99.99"
  },
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png",
      "fallback": "package",
      "background": "#FDC27D"
    }
  },
  "capabilities": [
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
